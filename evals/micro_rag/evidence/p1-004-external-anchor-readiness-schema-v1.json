{
  "$id": "https://smart-ward-hub.invalid/schema/p1-004-external-anchor-readiness-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchor_execution": {
      "const": "NOT_STARTED"
    },
    "authorization_boundary": {
      "const": {
        "clinical_validation_authorized": false,
        "external_authority": "NONE",
        "pilot_gate_status": "BLOCKED_PENDING_EXTERNAL_AUTHORIZATION",
        "production_authorized": false,
        "runtime_authority": "NONE"
      }
    },
    "clinical_validation": {
      "const": "PENDING"
    },
    "common_controls": {
      "additionalProperties": false,
      "required": [
        "evidence_class",
        "idempotency_formula",
        "receipt_verification_required",
        "delete_refusal_required",
        "trusted_time",
        "retention_and_access",
        "scope_ref",
        "window_ref",
        "rollback_ref",
        "provider_ref",
        "stop_rule"
      ],
      "type": "object"
    },
    "external_owner_appointment": {
      "type": "string"
    },
    "external_worm_verified": {
      "const": false
    },
    "freeze_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "independent_provider_validation": {
      "const": "UNVERIFIED"
    },
    "independent_verification_required": {
      "const": true
    },
    "local_anchor_claim": {
      "const": "TAMPER_EVIDENT_WITHIN_EDGE_TRUST_BOUNDARY"
    },
    "package_id": {
      "type": "string"
    },
    "project": {
      "const": "smart-ward-hub"
    },
    "schema_version": {
      "const": "p1-004-external-anchor-readiness-v1"
    },
    "software_evidence_only": {
      "const": true
    },
    "software_provider_identity": {
      "const": "software-anchor-stub"
    },
    "source_revision": {
      "type": "string"
    },
    "status": {
      "const": "EXTERNAL_ANCHOR_SOFTWARE_PREPARATION_READY"
    },
    "tracks": {
      "additionalProperties": false,
      "required": [
        "AC-001",
        "AC-002",
        "AC-003",
        "AC-004",
        "AC-005",
        "AC-006",
        "AC-007"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "project",
    "package_id",
    "source_revision",
    "freeze_manifest_sha256",
    "status",
    "anchor_execution",
    "independent_provider_validation",
    "clinical_validation",
    "software_evidence_only",
    "external_owner_appointment",
    "authorization_boundary",
    "software_provider_identity",
    "local_anchor_claim",
    "external_worm_verified",
    "tracks",
    "common_controls",
    "independent_verification_required"
  ],
  "title": "Smart Ward Hub P1-004 External Anchor Readiness",
  "type": "object"
}
