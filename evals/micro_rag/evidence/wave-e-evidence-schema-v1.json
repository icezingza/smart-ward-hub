      ],
      "IN_EXECUTION": [
        "BLOCKED",
        "READY_FOR_INDEPENDENT_REVIEW"
      ],
      "READY_FOR_EXTERNAL_EXECUTION": [
        "BLOCKED",
        "IN_EXECUTION"
      ],
      "READY_FOR_EXTERNAL_OWNER_APPOINTMENT": [
        "BLOCKED",
        "READY_FOR_EXTERNAL_EXECUTION"
      ],
      "READY_FOR_INDEPENDENT_REVIEW": [
        "BLOCKED",
        "CLOSED_NO_AUTHORIZATION"
      ]
    }
  },
