# Environment
SW_ENVIRONMENT=pilot
# Brand-neutral product metadata; replace values after brand approval.
SW_PRODUCT_NAME=IPD Smart Sentinel
SW_PRODUCT_SHORT_NAME=IPD Smart Sentinel Hub
SW_PRODUCT_DESCRIPTION=Sovereign Edge-First Patient Monitoring Hub
SW_AUTO_CREATE_DB=false
SW_SEED_DATA=false
SW_ENABLE_DOCS=false
SW_ALLOWED_HOSTS=127.0.0.1,localhost
SW_ALLOWED_ORIGINS=

# Pilot/production requires OIDC. Static auth is for local development/tests only.
SW_AUTH_MODE=oidc
# Set true only for an explicitly isolated local test; never use it in pilot/production.
SW_ALLOW_STATIC_AUTH_IN_NONLOCAL=false
# Required only for local static-auth tests. Load real credentials from a secret manager.
# SW_AUTH_TOKENS_JSON={"replace-this-token":["telemetry:read"]}
# Required when SW_AUTH_MODE=oidc.
SW_OIDC_ISSUER=https://idp.example.org/
SW_OIDC_AUDIENCE=smart-ward-hub
SW_OIDC_JWKS_URL=https://idp.example.org/.well-known/jwks.json
SW_OIDC_ALGORITHMS=RS256

# Edge durability and bounded telemetry recovery
SW_DATABASE_PATH=/var/lib/smart-ward-hub/ward_hub.db
SW_TELEMETRY_STATE_PATH=/var/lib/smart-ward-hub/edge_telemetry_state.json
SW_TELEMETRY_CHECKPOINT_EVERY=128
SW_TELEMETRY_BUFFER_MAX_SAMPLES=90000
SW_TELEMETRY_MAX_DEVICES=256
SW_TELEMETRY_MAX_SAMPLE_BYTES=16384
SW_TELEMETRY_MEMORY_ALARM_RATIO=0.90
SW_SQLITE_BUSY_TIMEOUT_MS=5000
SW_SQLITE_SYNCHRONOUS=FULL
SW_RATE_LIMIT_PER_MINUTE=6000
SW_AUDIT_LOG_PATH=/var/log/smart-ward-hub/audit_events.jsonl
SW_IDEMPOTENCY_TTL_SECONDS=86400
# Operational safety thresholds; missing runtime evidence blocks resume rather than assuming green.
SW_MAX_CHECKPOINT_AGE_SECONDS=300
SW_MAX_BACKUP_AGE_SECONDS=86400
SW_MAX_AUDIT_AGE_SECONDS=86400
SW_MAX_ANCHOR_AGE_SECONDS=86400
SW_MIN_DISK_FREE_RATIO=0.10
SW_MAX_SYNC_BACKLOG=0
SW_MAX_WORKER_QUEUE_BACKLOG=0
SW_MAX_UNRESOLVED_ALERTS=0
# Optional observed counters for the read-only operational snapshot.
# SW_SYNC_BACKLOG=0
# SW_WORKER_QUEUE_BACKLOG=0
# SW_UNRESOLVED_ALERTS=0
# Optional local append-only adapter; this is not an external WORM anchor.
SW_FORENSIC_ANCHOR_PATH=/var/lib/smart-ward-hub/forensic_anchors.jsonl
# Device Trust: disabled for legacy/local tests, observe for shadow mode, enforce after provisioning validation.
SW_DEVICE_TRUST_MODE=observe
SW_DEVICE_TRUST_CLOCK_SKEW_SECONDS=30

# Production deployment requirements:
# - Run with TLS and require client certificates for Hub-to-HIS mTLS.
#   Example Uvicorn flags: --ssl-certfile server.crt --ssl-keyfile server.key
#   --ssl-ca-certs hospital-ca.pem --ssl-cert-reqs 2
# - Keep private keys outside the repository and rotate certificates.
# - Do not commit real tokens or private keys.
# - Configure OAuth2/OIDC or an enterprise identity provider instead of static tokens.
# - The local forensic anchor is an adapter and must be replaced or mirrored to an
#   independently administered append-only/WORM service before relying on external evidence.
# - Rate limiting is process-local and requires an edge gateway or coordinated limiter
#   for multi-process or multi-node deployments.
# - In enforce mode, telemetry keeps the TelemetryPacket v1 body and requires
#   X-Device-Key-ID plus X-Device-Signature headers over canonical packet bytes.
# - Do not place device private keys, factory master secrets, or seed maps in source control.
# - The outside Admission Console is loopback-only in the reference implementation; use an
#   authenticated gateway and controlled network zone before exposing equivalent functionality.
# - Admission preparation accepts opaque patient/encounter tokens only. Raw HN/AN belongs in
#   the authorized Admission Gateway boundary and must not be sent to Hub Core.
# - Roaming Tablets require managed identity and OIDC/device credential validation before
#   production use. The software command API enforces scope, revision and idempotency but
#   does not by itself prove hardware-backed tablet identity.
