# Smart Ward Hub Wave 1 identity transport template
# This is a contract template, not a runnable production configuration.
# Fill only after external security owner appointment and approved non-production window.
# Never commit a populated copy, bearer token, private key or production endpoint.

SW_ENVIRONMENT=isolated_nonproduction
SW_AUTH_MODE=oidc
# LAN PDA pre-flight only; narrow to the managed ward subnet before any broader exposure.
SW_ALLOWED_HOSTS=*
SW_ALLOWED_ORIGINS=*

# External security owner must provide isolated non-production references.
SW_OIDC_ISSUER=__EXTERNAL_NONPROD_ISSUER_REF_REQUIRED__
SW_OIDC_AUDIENCE=__EXTERNAL_NONPROD_AUDIENCE_REF_REQUIRED__
SW_OIDC_JWKS_URL=https://__EXTERNAL_NONPROD_JWKS_HOST_REF_REQUIRED__/.well-known/jwks.json
SW_OIDC_ALGORITHMS=RS256

# Local file paths only; certificate/private-key material stays outside the repository.
SW_MTLS_CERTFILE=__LOCAL_NONPROD_CLIENT_CERT_PATH_REQUIRED__
SW_MTLS_KEYFILE=__LOCAL_NONPROD_CLIENT_KEY_PATH_REQUIRED__
SW_MTLS_CA_CERTS=__LOCAL_NONPROD_CA_BUNDLE_PATH_REQUIRED__

# Locked until external authorization decision; local code must not mutate these values.
SW_EXTERNAL_EXECUTION_AUTHORIZED=false
SW_CLINICAL_VALIDATION_AUTHORIZED=false
SW_PRODUCTION_AUTHORIZED=false
SW_RUNTIME_AUTHORITY=NONE
SW_EXTERNAL_AUTHORITY=NONE
SW_PILOT_GATE_STATUS=BLOCKED_PENDING_EXTERNAL_AUTHORIZATION

# Validation boundary: local shape/file checks are not live IdP, mTLS, rotation,
# revocation, ACL, custody, clinical or production evidence.
